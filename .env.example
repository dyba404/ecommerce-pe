# Plantilla de variables (NO son valores reales: este archivo se commitea vacío a propósito).
# Copiar a .env real (gitignored) y pedir cada clave al dueño del servicio. Nada de secretos en git.
# Dónde obtenerlas: CulqiPanel > Desarrollo > API Keys / RSA Keys; Stripe Dashboard > Developers > API keys.

# --- Medusa backend ---
DATABASE_URL=postgresql://user:pass@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
# Generar: openssl rand -hex 32 (uno distinto por variable y por entorno).

# --- Storefront (solo claves publishable al frente) ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=pe
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# --- Culqi (primario PE; llaves test empiezan pk_test_/sk_test_) ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_RSA_ID=
CULQI_RSA_PUBLIC_KEY=
NEXT_PUBLIC_CULQI_PUBLIC_KEY=

# --- Stripe (secundario; llaves test sk_test_/pk_test_, webhook whsec_) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_KEY=

# --- FASE 2 ---
FIRECRAWL_API_KEY=
SGAI_API_KEY=
TYPESAFE_API_KEY=
JEV_BACKEND=mock

# --- Notificaciones (ver docs/10-notificaciones.md; valores reales en .env gitignored) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BREVO_API_KEY=
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_REGION=
